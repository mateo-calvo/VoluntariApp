# Copiá este archivo como .env y completá los valores reales.
# El .env NO se sube a git. Pedí la DATABASE_URL por privado.

DJANGO_DEBUG=True
DJANGO_SECRET_KEY=una-clave-larga-y-aleatoria

# Supabase > Connect > Direct > "Session pooler".
# Si la contraseña tiene símbolos, codificalos (ej: ! -> %21).
# Si no definís DATABASE_URL, se usa SQLite local.
DATABASE_URL=postgresql://postgres.ID_PROYECTO:PASSWORD@HOST.pooler.supabase.com:5432/postgres?sslmode=require

# Supabase Auth
SUPABASE_URL=https://ID_PROYECTO.supabase.co
SUPABASE_ANON_KEY=tu-anon-key-de-supabase

# Chatbot TeAyudo: cuando las reglas no entienden, responde una IA con el contenido de faq.json.
# Orden: Groq primero y Gemini de respaldo. Si fallan las dos, se usa el mensaje de las reglas.
GROQ_API_KEY=tu-api-key-de-groq
# Nombre exacto del modelo de Groq (copialo de la consola de Groq; se usa con reasoning_effort, o sea un modelo gpt-oss).
GROQ_MODEL=
GEMINI_API_KEY=tu-api-key-de-gemini
# Opcional. Si no lo definís se usa gemini-3.5-flash-lite.
# GEMINI_MODEL=gemini-3.5-flash-lite

# Límites del chat (opcionales; estos son los valores por defecto).
# Usuario con sesión iniciada e IP: aplican a todos los mensajes del chat.
# CHAT_LIMITE_USUARIO_MIN=8
# CHAT_LIMITE_USUARIO_DIA=150
# CHAT_LIMITE_IP_MIN=15
# CHAT_LIMITE_IP_DIA=300
# Tope de llamadas a la IA (Groq + Gemini) en todo el servidor: si se alcanza, el chat sigue
# respondiendo con el FAQ y las reglas, sin IA. Ajustalos a la cuota gratuita que muestre cada consola.
# CHAT_IA_LIMITE_MIN=20
# CHAT_IA_LIMITE_DIA=300
# Detrás de un proxy (Render, Nginx...): cuántos hay delante de Django. Con 0 se ignora X-Forwarded-For.
# NUM_PROXIES=0
